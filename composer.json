{
    "name": "mateusfbi/totvs-rm-soap",
    "description": "Biblioteca SOAP para integração com TOTVS RM — funciona com Laravel ou PHP puro",
    "keywords": ["soap", "totvs", "rm", "laravel", "totvs-rm", "php"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mateus Brandao",
            "email": "mateusfbi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-soap": "*",
        "ext-xml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3"
    },
    "replace": {
        "mateusfbi/totvs-rm-soap-laravel": "self.version"
    },
    "suggest": {
        "illuminate/support": "Necessário apenas para usar o Service Provider e a Facade no Laravel"
    },
    "autoload": {
        "psr-4": {
            "mateusfbi\\TotvsRmSoap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "mateusfbi\\TotvsRmSoap\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --group integration",
        "format": "pint",
        "format:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "ci": ["@format:test", "@analyse", "@test"]
    },
    "extra": {
        "laravel": {
            "providers": [
                "mateusfbi\\TotvsRmSoap\\Providers\\TotvsRmSoapProvider"
            ],
            "aliases": {
                "TotvsRM": "mateusfbi\\TotvsRmSoap\\Facades\\TotvsRM"
            }
        }
    }
}
